{
  "name": "deutsch-study-notes",
  "private": true,
  "version": "0.5.0",
  "description": "CEFR German study notes with Persian glosses",
  "scripts": {
    "lint": "markdownlint-cli '**/*.md' --config .markdownlint.json --ignore node_modules --ignore legacy",
    "validate": "python tools/validate_corpus.py --root .",
    "export:tsv": "python tools/export_tsv.py --root .",
    "dedupe:check": "python tools/find_duplicates.py ."
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1"
  }
}
